#!/bin/bash
# post-commit: 记忆提醒（时间判定版）
# 当日记忆文件 mtime 与本次提交时间差 ≤ 60 秒 → 视为已记录，静默
# 否则提醒。不阻挡任何 git 操作。

ct=$(git log -1 --format='%ct' 2>/dev/null)
[ -z "$ct" ] && exit 0

mem=~/onespace/github/one-hippocampus/memory/$(date +%Y-%m)/$(date +%Y-%m-%d).md
mt=$(stat -c %Y "$mem" 2>/dev/null || echo 0)

diff=$(( ct - mt ))
[ "$diff" -lt 0 ] && diff=$(( -diff ))

if [ "$diff" -le 60 ]; then
  exit 0
fi

last=$(git log -1 --format='%h %s' 2>/dev/null)
echo ""
echo "🔔 记忆提醒：提交 ${last} 前后 1 分钟内未见记忆更新"
echo "   请按宪法向 ${mem} 追加流水段（先记后提，提交前完成记忆写入）"
echo ""
