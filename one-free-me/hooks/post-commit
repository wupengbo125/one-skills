#!/bin/bash
# post-commit: 提交完成后的记忆提醒
# 不验证、不阻挡——只提醒"别忘了更新今日记忆"
# 海马体自身的记忆提交（含 memory/）静默

self=$(git show --name-only --format='' HEAD 2>/dev/null | grep -E 'memory/[0-9]{4}-[0-9]{2}/' | head -1)
if [ -n "$self" ]; then
  exit 0
fi

last=$(git log -1 --format='%h %s' 2>/dev/null)
echo ""
echo "🔔 记忆提醒：本次提交 ${last} 已完成"
echo "   别忘了按宪法更新海马体今日记忆（memory/$(date +%Y-%m)/$(date +%Y-%m-%d).md），已记录可忽略"
echo ""
