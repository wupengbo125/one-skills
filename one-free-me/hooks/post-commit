#!/bin/bash
# post-commit: 宪法提醒——本次提交若未包含记忆更新则输出提醒
# 不阻挡任何 git 操作（post-commit 在提交完成后运行）

changed=$(git show --name-only --format='' HEAD 2>/dev/null | grep -E 'memory/[0-9]{4}-[0-9]{2}/' | head -1)
if [ -n "$changed" ]; then
  exit 0
fi

last=$(git log -1 --format='%s' 2>/dev/null)
echo ""
echo "=============================================="
echo " ⚠️ 宪法提醒：本次提交「${last}」尚未记录到记忆"
echo "    请按 one-free-me 规程向 ~/onespace/github/one-hippocampus/memory/$(date +%Y-%m)/$(date +%Y-%m-%d).md 追加流水段后补记"
echo "=============================================="
echo ""
