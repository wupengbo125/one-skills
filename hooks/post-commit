#!/bin/bash
# post-commit: 宪法提醒——本次提交是否已登记到海马体当日记忆
# 跨仓库验证：取本次提交 hash，在 one-hippocampus 当日文件中查找
# 不阻挡任何 git 操作（post-commit 在提交完成后运行）

# 海马体仓库自身的提交（含 memory/ 更新）直接静默
self=$(git show --name-only --format='' HEAD 2>/dev/null | grep -E 'memory/[0-9]{4}-[0-9]{2}/' | head -1)
if [ -n "$self" ]; then
  exit 0
fi

hash=$(git log -1 --format='%h' 2>/dev/null)
[ -z "$hash" ] && exit 0
last=$(git log -1 --format='%s' 2>/dev/null)

mem=~/onespace/github/one-hippocampus/memory/$(date +%Y-%m)/$(date +%Y-%m-%d).md
if [ -f "$mem" ] && grep -q "$hash" "$mem" 2>/dev/null; then
  exit 0
fi

echo ""
echo "=============================================="
echo " ⚠️ 宪法提醒：提交 ${hash}「${last}」尚未登记到记忆"
echo "    请按 one-free-me 规程向 ${mem}"
echo "    追加流水段并在括号内标注本次 hash（如「(对应提交 ${hash})」）后补记"
echo "=============================================="
echo ""
