#!/bin/bash
# 强制：代码仓库提交必须带 [memory: <hash>]，hash 需存在于海马体仓库
# 用户手动提交：git commit --no-verify 跳过

MSG_FILE="$1"
HASH=$(grep -oP '\[memory:\s*\K[a-f0-9]{7,40}' "$MSG_FILE" 2>/dev/null | head -1)

if [ -z "$HASH" ]; then
  echo "❌ 拒绝提交：commit message 必须带 [memory: <commit-hash>]"
  echo "   流程：先提交海马体记忆 → 拿到 hash → 再提交本仓库"
  echo "   手动提交：git commit --no-verify"
  exit 1
fi

if ! (git -C ~/onespace/github/one-hippocampus cat-file -t "$HASH" 2>/dev/null | grep -q commit); then
  echo "❌ 拒绝提交：海马体仓库不存在 commit $HASH"
  exit 1
fi

exit 0
