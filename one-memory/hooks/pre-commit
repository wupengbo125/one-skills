#!/bin/bash
# pre-commit: 强制代码改动与项目 onememory/ 随身记忆原子提交
# 只对 AI Agent 会话生效；人工提交自动放行（等同 --no-verify）

# Agent 会话带会话 ID 环境变量，人工终端没有
if [ -z "$CODEBUDDY_SESSION_ID" ] && [ -z "$CLAUDE_SESSION_ID" ]; then
  exit 0
fi

NON_MEMORY=$(git diff --cached --name-only | grep -vE '^onememory/' | head -1)
MEMORY=$(git diff --cached --name-only | grep -E '^onememory/' | head -1)

if [ -n "$NON_MEMORY" ] && [ -z "$MEMORY" ]; then
  echo "❌ 拒绝提交：检测到修改，但暂存区未包含 onememory/ 记忆沉淀！"
  echo "   规程：参考技能 one-memory。"
  exit 1
fi

# 海马记忆仓等号校验：远端当日文件须含本项目同一句话的摘要
if [ -n "$NON_MEMORY" ]; then
  LOCAL=$(git show :onememory/timeline.md 2>/dev/null | tail -1 | sed 's/^- [0-9-]* [0-9:]* //')
  PROJ=$(git rev-parse --show-toplevel | sed "s|^$HOME|~|")
  REMOTE=$(gh api "repos/wupengbo125/one-hippocampus/contents/memory/$(date +%Y-%m)/$(date +%Y-%m-%d).md" --jq .content 2>/dev/null | base64 -d 2>/dev/null | grep -F "[$PROJ]" | tail -1 | sed 's/^- [0-9:]* \[[^]]*\] //')
  if [ -z "$REMOTE" ]; then
    echo "❌ 拒绝提交：海马记忆仓今日无 [$PROJ] 记录！先按 one-memory Step 3 远端落盘。"
    exit 1
  fi
  if [ "$REMOTE" != "$LOCAL" ]; then
    echo "❌ 拒绝提交：海马记忆仓摘要与 timeline.md 末行不一致！"
    echo "   本仓库：$LOCAL"
    echo "   海马仓：$REMOTE"
    exit 1
  fi
fi

exit 0
