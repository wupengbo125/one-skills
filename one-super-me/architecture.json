  "cards": [
    {
      "dot": "cyan",
      "title": "显式记录链路（人类指令）",
      "items": [
        "人类明确下达“帮我记东西/记到文档/避坑手册”时激活",
        "在 onewiki/ 撰写单层平铺避坑长文，并在 index.md 登记",
        "保存后调用 super-me sync 增量写入本地 SQLite FTS5 数据库"
      ]
    },
    {
      "dot": "emerald",
      "title": "无脑收工链路（零心智负担）",
      "items": [
        "会话结束随手甩“超级我/收工/下班”，用户不费心思考",
        "防垃圾门禁：日常闲聊或无硬核改动直接阻断退出，零垃圾写入",
        "四维提炼：画像入 system/、实操入 memory/、流水追加至 recent.md"
      ]
    },
    {
      "dot": "rose",
      "title": "纯数据仓与统一 CLI 引擎",
      "items": [
        "严格分立 system/（画像代号）与 memory/（四维知识库）",
        "super-me CLI 统一驱动 BM25 毫秒全文检索与双阈值淘汰治理",
        "海马体仓内纯 Markdown 数据，.fts.db 本地存放严禁入 Git"
      ]
    }
  ]
