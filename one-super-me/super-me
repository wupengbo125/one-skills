def extract_chat_text(raw_text):
    """解析 Hook 传入的各种 JSON 或文本负载，提取人机对话与工具操作轨迹"""
    s = raw_text.strip()
    if not s:
        return ""
    if s.startswith("{") and s.endswith("}"):
        try:
            data = json.loads(s)
            # 如果是 OMP 扩展传入的 session_file
            if "session_file" in data and os.path.isfile(data["session_file"]):
                with open(data["session_file"], "r", encoding="utf-8", errors="ignore") as sf:
                    file_content = sf.read()
                    return extract_chat_text(file_content)

            extracted = []
            for key in ["transcript", "messages", "turns"]:
                if key in data and isinstance(data[key], list):
                    for item in data[key]:
                        if isinstance(item, dict):
                            role = item.get("role", "")
                            c = item.get("content", "")
                            if isinstance(c, list):
                                for block in c:
                                    if isinstance(block, dict) and block.get("type") == "text":
                                        extracted.append(f"[{role}]: {block.get('text', '')}")
                            elif c and isinstance(c, str):
                                extracted.append(f"[{role}]: {c}")
                    if extracted:
                        return "\n".join(extracted)
        except Exception:
            pass
    elif "\n{" in s or s.startswith("{\""):
        # 处理 jsonl 格式
        lines = s.splitlines()
        extracted = []
        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                item = json.loads(line)
                if isinstance(item, dict):
                    role = item.get("role", item.get("type", ""))
                    c = item.get("content", item.get("message", ""))
                    if isinstance(c, str) and c:
                        extracted.append(f"[{role}]: {c}")
            except Exception:
                pass
        if extracted:
            return "\n".join(extracted)

    return raw_text

def call_llm(prompt):
    """
    通用大模型调用管道：
    1. 优先调用配置的 OpenAI 兼容端点 (~/.config/one-super-me/config.env 或环境变量)
    2. 若未配置外部 API，自动回退借用宿主已登录的本地 Agent CLI (如 claude -p)
    """
    base_url, api_key, model = get_llm_config()

    # 方式 1：如果配置了外部模型端点，走标准 API 请求
    if base_url:
        endpoint = base_url.rstrip("/") + "/chat/completions"
        payload = {
            "model": model or "gpt-4o-mini",
            "messages": [
                {"role": "system", "content": "You are a professional cognitive extraction assistant. Output strictly JSON."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.2
        }
        try:
            data = json.dumps(payload).encode("utf-8")
            req = urllib.request.Request(
                endpoint,
                data=data,
                headers={
                    "Content-Type": "application/json",
                    "Authorization": f"Bearer {api_key}"
                }
            )
            with urllib.request.urlopen(req, timeout=40) as resp:
                resp_body = resp.read().decode("utf-8")
                res_json = json.loads(resp_body)
                return res_json["choices"][0]["message"]["content"].strip()
        except Exception as e:
            print(f">>> [Super-Me] 外部大模型 API 调用失败 ({e})，尝试回退宿主原生 CLI...")

    # 方式 2：宿主自带模型免配置借用 (小明不用额外买任何 API)
    if shutil.which("claude"):
        try:
            res = subprocess.run(
                ["claude", "-p", prompt, "--allowed-tools", ""],
                capture_output=True,
                text=True,
                timeout=60
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
        except Exception as e:
            print(f">>> [Super-Me] 调用宿主 claude 失败: {e}")

    if shutil.which("omp"):
        try:
            res = subprocess.run(
                ["omp", "-p", prompt],
                capture_output=True,
                text=True,
                timeout=60
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
        except Exception:
            pass

    print(">>> [Super-Me] 提示：未检测到可用的大模型通道（请在 ~/.config/one-super-me/config.env 配置或确保宿主 CLI 可用）。")
    return None

