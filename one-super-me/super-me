def cmd_hook_install(agent_name=None, custom_opts=None):
    custom_opts = custom_opts or {}
    real_script = get_script_path()

    # 确保 ~/.local/bin/super-me 全局快捷入口
    local_bin = os.path.expanduser("~/.local/bin")
    os.makedirs(local_bin, exist_ok=True)
    symlink_path = os.path.join(local_bin, "super-me")
    try:
        if os.path.lexists(symlink_path):
            os.remove(symlink_path)
        os.symlink(real_script, symlink_path)
        os.chmod(real_script, 0o755)
    except Exception:
        pass

    # 处理目标 Agent
    if not agent_name:
        print("==================================================================")
        print("      One Super-Me (超级我) 目标 Agent 钩子安装向导")
        print("==================================================================")
        print("请选择要挂载的目标 Agent 宿主：")
        print("  1) Claude Code (挂载至 ~/.claude/settings.json 的 Stop 钩子)")
        print("  2) OMP / Pi Agent (挂载至 ~/.omp/agent/extensions/)")
        choice = input("请输入选项编号 (默认 1): ").strip() or "1"
        agent_name = "claude" if choice == "1" else "omp"

    agent_name = agent_name.lower()
    if agent_name not in ["claude", "omp"]:
        print(f"❌ 不支持的 Agent 目标: {agent_name} (仅支持 claude 或 omp)")
        sys.exit(1)

    # 处理配置
    cfg_dir = os.path.expanduser("~/.config/one-super-me")
    cfg_file = os.path.join(cfg_dir, "config.env")
    os.makedirs(cfg_dir, exist_ok=True)

    if not os.path.isfile(cfg_file) or custom_opts:
        url = custom_opts.get("url", os.environ.get("OPENAI_BASE_URL", ""))
        key = custom_opts.get("key", os.environ.get("OPENAI_API_KEY", ""))
        model = custom_opts.get("model", os.environ.get("OPENAI_MODEL", ""))
        repo = custom_opts.get("repo", os.environ.get("ONE_HIPPOCAMPUS_DIR", DEFAULT_HIPPOCAMPUS_DIR))
        with open(cfg_file, "w", encoding="utf-8") as f:
            f.write(f'OPENAI_BASE_URL="{url}"\n')
            f.write(f'OPENAI_API_KEY="{key}"\n')
            f.write(f'OPENAI_MODEL="{model}"\n')
            f.write(f'ONE_HIPPOCAMPUS_DIR="{repo}"\n')

    # 挂载钩子
    mount_desc = ""
    hook_cmd = f"{symlink_path} hook run"

    if agent_name == "claude":
        claude_dir = os.path.expanduser("~/.claude")
        settings_file = os.path.join(claude_dir, "settings.json")
        os.makedirs(claude_dir, exist_ok=True)
        data = {}
        if os.path.isfile(settings_file):
            try:
                data = json.load(open(settings_file, "r", encoding="utf-8"))
            except Exception:
                data = {}

        hooks = data.setdefault("hooks", {})
        stop_list = hooks.setdefault("Stop", [])

        # 幂等清理已有 super-me 相关钩子
        clean_stops = []
        for item in stop_list:
            inner_hooks = item.get("hooks", [])
            has_super_me = any("super-me" in h.get("command", "") or "client.py" in h.get("command", "") for h in inner_hooks)
            if not has_super_me:
                clean_stops.append(item)

        clean_stops.append({
            "hooks": [
                {
                    "type": "command",
                    "command": hook_cmd,
                    "timeout": 60
                }
            ]
        })
        data["hooks"]["Stop"] = clean_stops
        with open(settings_file, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        mount_desc = f"{settings_file} (Stop 事件)"

    elif agent_name == "omp":
        ext_dir = os.path.expanduser("~/.omp/agent/extensions")
        os.makedirs(ext_dir, exist_ok=True)
        ext_file = os.path.join(ext_dir, "one-super-me-hook.ts")
        ts_code = f"""// One Super-Me Session Shutdown Hook
import {{ spawn }} from 'child_process';
import * as fs from 'fs';

export default function (pi: any) {{
  pi.on('session_shutdown', async (_event: any, ctx: any) => {{
    try {{
      const sessionFile = ctx?.sessionManager?.getSessionFile?.();
      const proc = spawn('{symlink_path}', ['hook', 'run'], {{
        detached: true,
        stdio: ['pipe', 'ignore', 'ignore'],
      }});
      if (sessionFile && fs.existsSync(sessionFile)) {{
        const stream = fs.createReadStream(sessionFile);
        stream.pipe(proc.stdin);
      }} else {{
        proc.stdin.end();
      }}
      proc.unref();
    }} catch (_) {{}}
  }});
}}
"""
        with open(ext_file, "w", encoding="utf-8") as f:
            f.write(ts_code)
        mount_desc = ext_file

    # 初始化数据库
    repo_dir = get_hippocampus_dir()
    db_path = get_db_path(repo_dir)
    if not os.path.isfile(db_path):
        cmd_rebuild()

    # 打印透明回执
    base_url, _, model = get_llm_config()
    llm_desc = f"{model} @ {base_url}" if base_url else "开箱即用（借用宿主已登录的原生模型 CLI）"

    print("\n==================================================================")
    print("🎉 One Super-Me 统一钩子已成功安装！")
    print("==================================================================")
    print(f"🎯 目标 Agent:    {agent_name}")
    print(f"🪝 挂载位置:      {mount_desc}")
    print(f"📜 钩子执行指令:  {hook_cmd}")
    print(f"🧠 四维提炼落盘:  画像(profile) | 方法(methods) | 位置(locations) | 流水(recent)")
    print(f"🤖 认知模型通道:  {llm_desc}")
    print(f"📁 海马体数据仓:  {repo_dir}")
    print("------------------------------------------------------------------")
    print("💡 小明如何一键自检与验证？")
    print("   请在终端直接执行一行自检命令：")
    print(f"   super-me hook test")
    print("   若看到【四维认知全链路自检完成】，即代表全链路 100% 畅通！")
    print("==================================================================\n")

def cmd_hook_uninstall(agent_name=None):
    if not agent_name or agent_name == "all":
        agent_name = "all"

    print(f">>> 正在注销 One Super-Me 钩子 (目标: {agent_name})...")

    if agent_name in ["claude", "all"]:
        settings_file = os.path.expanduser("~/.claude/settings.json")
        if os.path.isfile(settings_file):
            try:
                data = json.load(open(settings_file, "r", encoding="utf-8"))
                stop_list = data.get("hooks", {}).get("Stop", [])
                clean_stops = []
                for item in stop_list:
                    inner_hooks = item.get("hooks", [])
                    has_sm = any("super-me" in h.get("command", "") or "client.py" in h.get("command", "") for h in inner_hooks)
                    if not has_sm:
                        clean_stops.append(item)
                data["hooks"]["Stop"] = clean_stops
                with open(settings_file, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2, ensure_ascii=False)
                print("  [✓] 已从 ~/.claude/settings.json 中移除 Stop 钩子")
            except Exception as e:
                print(f"  [-] 移除 Claude 钩子异常: {e}")

    if agent_name in ["omp", "all"]:
        ext_file = os.path.expanduser("~/.omp/agent/extensions/one-super-me-hook.ts")
        if os.path.isfile(ext_file):
            os.remove(ext_file)
            print(f"  [✓] 已移除 OMP 扩展: {ext_file}")

    print(">>> 钩子注销完成（海马体数据与本地配置完整保留）。")

