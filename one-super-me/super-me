def load_config():
    """加载 ~/.config/one-super-me/config.env，环境变量优先"""
    cfg_file = os.path.expanduser("~/.config/one-super-me/config.env")
    if os.path.isfile(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip("'\"")
                    if k and k not in os.environ:
                        os.environ[k] = v
        except Exception:
            pass

def get_llm_config():
    load_config()
    base_url = os.environ.get("OPENAI_BASE_URL") or os.environ.get("AI_API")
    api_key = os.environ.get("OPENAI_API_KEY") or os.environ.get("AI_API_KEY") or "EMPTY"
    model = os.environ.get("OPENAI_MODEL") or os.environ.get("AI_MODEL") or ""
    return base_url, api_key, model

def get_hippocampus_dir():
    load_config()
    custom = os.environ.get("ONE_HIPPOCAMPUS_DIR")
    if custom:
        p = os.path.abspath(os.path.expanduser(custom))
        if os.path.isdir(p):
            return p
    d = os.path.abspath(DEFAULT_HIPPOCAMPUS_DIR)
    if not os.path.isdir(d):
        alt = "/home/ctyun/onespace/github/one-hippocampus"
        if os.path.isdir(alt):
            return alt
    return d

def get_db_path(repo_dir):
    return os.path.join(repo_dir, ".fts.db")

def cjk_spaced(s):
    if not s:
        return ""
    # 在相邻 CJK 字符之间插入空格，使 SQLite FTS5 unicode61 支持中文字词匹配
    return re.sub(r'(?<=[\u3400-\u9fff])(?=[\u3400-\u9fff])', ' ', s)

def extract_title(text, path):
    m = re.search(r'^#\s+(.+)', text, re.M)
    if m:
        return m.group(1).strip()
    return os.path.splitext(os.path.basename(path))[0]

def sanitize_filename(name):
    clean = re.sub(r'[/\\:\*?"<>|#]', '', name).strip()
    clean = re.sub(r'\s+', '_', clean)
    return clean[:60] if clean else "未命名记录"

# ==============================================================================
# SQLite FTS5 BM25 检索与索引引擎
# ==============================================================================

def init_db(conn):
    conn.execute("""
    CREATE VIRTUAL TABLE IF NOT EXISTS docs_fts USING fts5(
        path UNINDEXED,
        title,
        content,
        tokenize = 'unicode61'
    );
    """)
    conn.commit()

def cmd_sync(rel_path):
    repo_dir = get_hippocampus_dir()
    db_path = get_db_path(repo_dir)
    full_path = os.path.join(repo_dir, rel_path)

    if not os.path.isfile(full_path):
        conn = sqlite3.connect(db_path)
        init_db(conn)
        conn.execute("DELETE FROM docs_fts WHERE path = ?", (rel_path,))
        conn.commit()
        conn.close()
        print(f">>> [Super-Me BM25] 移除已删除文档索引: {rel_path}")
        return

    try:
        content = open(full_path, "r", encoding="utf-8", errors="ignore").read()
    except Exception as e:
        print(f">>> [Super-Me BM25] 读取文件失败 {rel_path}: {e}")
        return

    title = extract_title(content, rel_path)
    title_tok = cjk_spaced(title)
    content_tok = cjk_spaced(content)

    conn = sqlite3.connect(db_path)
    init_db(conn)
    conn.execute("DELETE FROM docs_fts WHERE path = ?", (rel_path,))
    conn.execute(
        "INSERT INTO docs_fts(path, title, content) VALUES(?, ?, ?)",
        (rel_path, title_tok, content_tok)
    )
    conn.commit()
    conn.close()
    print(f">>> [Super-Me BM25] 增量同步完成: {rel_path}")

def cmd_rebuild():
    repo_dir = get_hippocampus_dir()
    db_path = get_db_path(repo_dir)
    print(f">>> [Super-Me BM25] 开始全量重建索引: {repo_dir}")

    if os.path.exists(db_path):
        try:
            os.remove(db_path)
        except Exception:
            pass

    conn = sqlite3.connect(db_path)
    init_db(conn)

    valid_exts = {".md", ".markdown"}
    indexed_count = 0

    for root, dirs, files in os.walk(repo_dir):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ["venv", "node_modules", "target"]]
        for f in files:
            ext = os.path.splitext(f)[1].lower()
            if ext in valid_exts:
                full_path = os.path.join(root, f)
                rel_path = os.path.relpath(full_path, repo_dir)
                try:
                    content = open(full_path, "r", encoding="utf-8", errors="ignore").read()
                    title = extract_title(content, rel_path)
                    title_tok = cjk_spaced(title)
                    content_tok = cjk_spaced(content)
                    conn.execute(
                        "INSERT INTO docs_fts(path, title, content) VALUES(?, ?, ?)",
                        (rel_path, title_tok, content_tok)
                    )
                    indexed_count += 1
                except Exception as e:
                    print(f"  [-] 跳过损坏文件 {rel_path}: {e}")

    conn.commit()
    conn.close()
    print(f">>> [Super-Me BM25] 重建完成，共索引 {indexed_count} 篇海马体文档。")

def cmd_search(query_str):
    if not query_str or not query_str.strip():
        print(">>> [Super-Me BM25] 请输入搜索关键词")
        return

    repo_dir = get_hippocampus_dir()
    db_path = get_db_path(repo_dir)

    if not os.path.isfile(db_path):
        print(">>> [Super-Me BM25] 索引库不存在，正在初始化全量建库...")
        cmd_rebuild()

    terms = query_str.strip().split()
    query_parts = []
    for t in terms:
        cleaned = re.sub(r'[\"\']', '', t)
        if not cleaned:
            continue
        tok = cjk_spaced(cleaned)
        query_parts.append(f'"{tok}"')

    if not query_parts:
        print(">>> [Super-Me BM25] 关键词无效")
        return

    fts_query = " AND ".join(query_parts)

    conn = sqlite3.connect(db_path)
    init_db(conn)
    cursor = conn.cursor()

    sql = """
    SELECT path, title, snippet(docs_fts, 2, '【', '】', '...', 24), bm25(docs_fts) as score
    FROM docs_fts
    WHERE docs_fts MATCH ?
    ORDER BY score ASC
    LIMIT 10
    """

    try:
        cursor.execute(sql, (fts_query,))
        rows = cursor.fetchall()
    except sqlite3.OperationalError:
        fts_query = " OR ".join(query_parts)
        cursor.execute(sql, (fts_query,))
        rows = cursor.fetchall()

    conn.close()

    if not rows:
        print(f">>> [Super-Me BM25] 未检索到包含 '{query_str}' 的相关文档")
        return

    print(f">>> [Super-Me BM25] 检索 '{query_str}' 命中结果（相关度排序）：\n")
    for i, (path, title_tok, snippet, score) in enumerate(rows, start=1):
        clean_title = re.sub(r'(?<=[\u3400-\u9fff])\s+(?=[\u3400-\u9fff])', '', title_tok)
        clean_snippet = re.sub(r'(?<=[\u3400-\u9fff])\s+(?=[\u3400-\u9fff])', '', snippet).replace("\n", " ")
        print(f"[{i}] {path} (BM25评分: {score:.3f})")
        print(f"    标题: {clean_title[:35]}")
        print(f"    摘要: {clean_snippet[:120]}")
        print()

def cmd_clean_recent():
    repo_dir = get_hippocampus_dir()
    recent_file = os.path.join(repo_dir, "recent.md")
    if not os.path.isfile(recent_file):
        print(f">>> [Super-Me 治理] 文件不存在: {recent_file}")
        return

    content = open(recent_file, "r", encoding="utf-8").read()
    lines = content.splitlines()

    header_lines = []
    table_rows = []
    in_table = False

    for line in lines:
        if line.strip().startswith("|") and ("---" in line or "实体" in line):
            header_lines.append(line)
            in_table = True
        elif in_table and line.strip().startswith("|"):
            table_rows.append(line)
        elif not in_table:
            header_lines.append(line)

    now = datetime.now()
    cutoff_date = (now - timedelta(days=60)).strftime("%Y-%m-%d")

    valid_entries = []
    for row in table_rows:
        parts = [p.strip() for p in row.strip().split("|")[1:-1]]
        if len(parts) >= 3:
            entity, pointer, date_str = parts[0], parts[1], parts[2]
            m = re.search(r'\d{4}-\d{2}-\d{2}', date_str)
            if m:
                d_val = m.group(0)
                if d_val >= cutoff_date:
                    valid_entries.append((d_val, row))
                else:
                    print(f"  [-] 超期淘汰 (>60天): {entity} ({d_val})")
            else:
                valid_entries.append(("1970-01-01", row))

    valid_entries.sort(key=lambda x: x[0], reverse=True)

    if len(valid_entries) > 100:
        removed = valid_entries[100:]
        valid_entries = valid_entries[:100]
        for _, r in removed:
            print(f"  [-] 超量淘汰 (超出100条上限): {r}")

    new_rows = [r for _, r in valid_entries]
    new_content = "\n".join(header_lines) + "\n" + "\n".join(new_rows) + "\n"
    with open(recent_file, "w", encoding="utf-8") as f:
        f.write(new_content)

    print(f">>> [Super-Me 治理] 近期记忆清理完成，当前保留 {len(new_rows)} 条有效记忆。")

