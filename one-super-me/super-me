【会话交互内容如下】:
%s
"""

def extract_and_persist(chat_text):
    """四维认知提炼并落盘至海马体，自动增量更新 .fts.db"""
    clean_text = extract_chat_text(chat_text)
    if len(clean_text.strip()) < 15:
        return

    # 截取近 10000 字符避免 token 溢出
    sample_text = clean_text[-10000:]
    prompt = COGNITIVE_PROMPT_TEMPLATE % sample_text

    content_text = call_llm(prompt)
    if not content_text or "NO_INCREMENT" in content_text:
        print(">>> [Super-Me] 经认知审视无新知识增量，保持静默。")
        return

    content_text = re.sub(r"^```json\s*", "", content_text, flags=re.I)
    content_text = re.sub(r"\s*```$", "", content_text)

    try:
        parsed = json.loads(content_text)
    except Exception:
        m = re.search(r"\{.*\}", content_text, re.S)
        if m:
            try:
                parsed = json.loads(m.group(0))
            except Exception:
                print(">>> [Super-Me] 模型输出无法解析为 JSON，跳过落盘。")
                return
        else:
            print(">>> [Super-Me] 未发现有效 JSON 增量，跳过落盘。")
            return

    repo_dir = get_hippocampus_dir()
    now_str = datetime.now().strftime("%Y-%m-%d %H:%M")
    today_str = datetime.now().strftime("%Y-%m-%d")

    # --------------------------------------------------------------------------
    # 维度 1：用户画像与偏好 (profile) -> system/profile.md
    # --------------------------------------------------------------------------
    profile_items = parsed.get("profile", [])
    if profile_items and isinstance(profile_items, list):
        profile_file = os.path.join(repo_dir, "system", "profile.md")
        os.makedirs(os.path.dirname(profile_file), exist_ok=True)
        with open(profile_file, "a", encoding="utf-8") as f:
            f.write(f"\n\n### 增量画像与偏好 ({now_str})\n")
            for item in profile_items:
                f.write(f"- {item}\n")
        print(">>> [Super-Me] 👤 用户画像已增量更新: system/profile.md")
        cmd_sync("system/profile.md")

    # --------------------------------------------------------------------------
    # 维度 2：独家操作方法 (methods) -> memory/methods/<中文主题>.md
    # --------------------------------------------------------------------------
    methods = parsed.get("methods", [])
    if methods and isinstance(methods, list):
        for m_item in methods:
            topic = sanitize_filename(m_item.get("topic", ""))
            content = m_item.get("content", "").strip()
            if topic and content:
                m_file = os.path.join(repo_dir, "memory", "methods", f"{topic}.md")
                os.makedirs(os.path.dirname(m_file), exist_ok=True)
                is_new = not os.path.isfile(m_file)
                with open(m_file, "a", encoding="utf-8") as f:
                    if is_new:
                        f.write(f"# {topic}\n\n{content}\n")
                    else:
                        f.write(f"\n\n## 增量实操记录 ({now_str})\n\n{content}\n")
                rel_p = os.path.relpath(m_file, repo_dir)
                print(f">>> [Super-Me] 🛠️ 操作方法沉淀入库: {rel_p}")
                cmd_sync(rel_p)

    # --------------------------------------------------------------------------
    # 维度 3：资产与资源位置 (locations) -> memory/locations/<中文主题>.md
    # --------------------------------------------------------------------------
    locations = parsed.get("locations", [])
    if locations and isinstance(locations, list):
        for l_item in locations:
            topic = sanitize_filename(l_item.get("topic", ""))
            content = l_item.get("content", "").strip()
            if topic and content:
                l_file = os.path.join(repo_dir, "memory", "locations", f"{topic}.md")
                os.makedirs(os.path.dirname(l_file), exist_ok=True)
                is_new = not os.path.isfile(l_file)
                with open(l_file, "a", encoding="utf-8") as f:
                    if is_new:
                        f.write(f"# {topic}\n\n{content}\n")
                    else:
                        f.write(f"\n\n## 增量资源记录 ({now_str})\n\n{content}\n")
                rel_p = os.path.relpath(l_file, repo_dir)
                print(f">>> [Super-Me] 🗺️ 资产位置沉淀入库: {rel_p}")
                cmd_sync(rel_p)

    # 别名映射 (aliases) -> system/aliases.md
    aliases = parsed.get("aliases", [])
    if aliases and isinstance(aliases, list):
        alias_file = os.path.join(repo_dir, "system", "aliases.md")
        if os.path.isfile(alias_file):
            with open(alias_file, "a", encoding="utf-8") as f:
                for a in aliases:
                    al = a.get("alias", "").strip()
                    tg = a.get("target", "").strip()
                    ds = a.get("desc", "").strip()
                    if al:
                        f.write(f"| **{al}** | `{tg}` | - | {ds} |\n")
            print(">>> [Super-Me] 🏷️ 项目别名映射更新: system/aliases.md")
            cmd_sync("system/aliases.md")

    # --------------------------------------------------------------------------
    # 维度 4：近期活跃流水 (recent) -> recent.md
    # --------------------------------------------------------------------------
    recent_entry = parsed.get("recent")
    if recent_entry and isinstance(recent_entry, dict):
        entity = recent_entry.get("entity", "").strip()
        summary = recent_entry.get("summary", "").strip()
        if entity and summary:
            recent_file = os.path.join(repo_dir, "recent.md")
            if os.path.isfile(recent_file):
                lines = open(recent_file, "r", encoding="utf-8").readlines()
                insert_idx = len(lines)
                for idx, line in enumerate(lines):
                    if line.strip().startswith("|") and ("---" in line or "实体" in line):
                        insert_idx = idx + 1
                new_line = f"| {entity} | {summary} | {today_str} |\n"
                lines.insert(insert_idx, new_line)
                with open(recent_file, "w", encoding="utf-8") as f:
                    f.writelines(lines)
                print(f">>> [Super-Me] ⚡ 近期活跃流水已记录: recent.md")
                cmd_sync("recent.md")

