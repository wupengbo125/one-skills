def print_help():
    print("""One Super-Me (超级我) - 统一全能命令行

用法:
  super-me <子命令> [参数...]

核心检索与索引 (纯本地算法，毫秒响应，零Token消耗):
  search <关键词>              BM25 极速检索海马体知识与避坑手册
  <关键词>                     快捷搜索模式
  sync <文件相对路径>          增量同步单篇文档到 .fts.db 索引
  rebuild                     全量重建海马体 .fts.db 索引
  clean                       近期记忆治理 (执行 60 天 / 100 条双阈值淘汰)

钩子与自动化四维认知提炼:
  hook install [claude|omp]   安装会话钩子到指定 Agent (透明回执与开箱即用)
  hook uninstall [claude|omp] 从指定 Agent 注销钩子
  hook run                    执行钩子提炼 (从 stdin 捕获会话，提取四维认知并写库)
  hook test                   全链路功能自检 (模拟输入、模型四维提取、落盘与查库)
""")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd in ["-h", "--help", "help"]:
        print_help()
    elif cmd == "hook":
        if len(sys.argv) < 3:
            print(">>> 请指定 hook 动作: install | uninstall | run | test")
            sys.exit(1)
        sub = sys.argv[2]
        if sub == "install":
            target = sys.argv[3] if len(sys.argv) >= 4 and not sys.argv[3].startswith("-") else None
            # 解析可选参数
            custom_opts = {}
            for i in range(3, len(sys.argv)):
                if sys.argv[i] == "--url" and i + 1 < len(sys.argv):
                    custom_opts["url"] = sys.argv[i+1]
                elif sys.argv[i] == "--key" and i + 1 < len(sys.argv):
                    custom_opts["key"] = sys.argv[i+1]
                elif sys.argv[i] == "--model" and i + 1 < len(sys.argv):
                    custom_opts["model"] = sys.argv[i+1]
            cmd_hook_install(target, custom_opts)
        elif sub == "uninstall":
            target = sys.argv[3] if len(sys.argv) >= 4 else "all"
            cmd_hook_uninstall(target)
        elif sub == "run":
            # 优先从 stdin 读取
            raw_input = ""
            if not sys.stdin.isatty():
                try:
                    raw_input = sys.stdin.read()
                except Exception:
                    pass
            if not raw_input and len(sys.argv) >= 4:
                raw_input = " ".join(sys.argv[3:])
            extract_and_persist(raw_input)
        elif sub == "test":
            cmd_hook_test()
        else:
            print(f">>> 未知的 hook 动作: {sub}")
            sys.exit(1)
    elif cmd == "rebuild":
        cmd_rebuild()
    elif cmd == "sync":
        if len(sys.argv) < 3:
            print(">>> 请指定待同步的文件相对路径")
            sys.exit(1)
        cmd_sync(sys.argv[2])
    elif cmd in ["clean", "clean-recent"]:
        cmd_clean_recent()
    elif cmd == "search":
        if len(sys.argv) < 3:
            print(">>> 请输入检索关键词")
            sys.exit(1)
        cmd_search(" ".join(sys.argv[2:]))
    else:
        cmd_search(" ".join(sys.argv[1:]))

if __name__ == "__main__":
    main()
