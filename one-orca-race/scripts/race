#!/usr/bin/env bash
# race.sh — Orca 多 Agent 并行赛马调度器（race.py 的 shell 版）
# 同一个需求 / Issue 同时派给多个 Agent，各自独立 Worktree 并发跑。
#
# 用法:
#   race.sh -a codex:gpt-5.2 omp claude:claude-3-7-sonnet:high codebuddy \
#           [-i <issue>] [-p "补充指令"] [-r <repo路径>] [-b main] [--dry-run]
set -euo pipefail

NATIVE_AGENTS="claude claude-agent-teams openclaude codex autohand ante trae opencode mimo-code pi omp prime-agent gemini antigravity aider goose amp kilo kiro crush aug cline codebuff command-code continue cursor droid kimi mistral-vibe qwen-code rovo hermes openclaw copilot grok devin"

usage() {
  cat >&2 <<'EOF'
用法: race.sh -a <agent[:model[:effort]]...> [-i <issue>] [-p <prompt>] [-r <repo>] [-b <base>] [--dry-run]

  -a, --agents       参赛 Agent 列表（空格分隔），如: -a codex:gpt-5.2 omp claude:claude-3-7-sonnet codebuddy
  -i, --issue        GitHub Issue 编号或 URL（gh issue view 抓取）
  -p, --prompt       追加/独立的自定义提示词
  -r, --repo         目标 Git 仓库路径（默认当前仓库）
  -b, --base-branch  基线分支（默认 main）
      --dry-run      只打印计划，不实际创建

  set-default-agent <agent>   记住默认 Agent，之后可省略 -a

说明:
  不给 -i 时自动取最新一条 open issue
  不给 -a 时用默认 Agent（需先 set-default-agent）
EOF
  exit 1
}

is_native() { [[ " $NATIVE_AGENTS " == *" $1 "* ]]; }

normalize_agent() {
  case "$1" in
    cbc | codebuddy-code | code-buddy) echo "codebuddy" ;;
    agy) echo "antigravity" ;;
    *) echo "$1" ;;
  esac
}

# 解析 agent[:model[:effort]]，结果写入全局变量 AGENT_ID / A_MODEL / A_EFFORT
# 注意：必须用 `parse_spec x` 直接调用，不能用 $(...) 包（子 shell 会丢全局变量）
parse_spec() {
  local spec="$1" rest tail
  AGENT_ID="$(normalize_agent "${spec%%:*}")"
  A_MODEL=""
  A_EFFORT=""
  rest="${spec#*:}"
  if [[ "$rest" != "$spec" ]]; then
    A_MODEL="${rest%%:*}"
    tail="${rest#*:}"
    if [[ "$tail" != "$rest" ]]; then
      A_EFFORT="$tail"
    fi
  fi
}

# ---- 参数解析 ----
AGENTS=()
ISSUE=""
PROMPT=""
REPO_ARG=""
BASE="main"
DRY_RUN=0
DEFAULT_FILE="$HOME/.config/race/default-agent"

# 子命令：记住默认 agent
if [[ "${1:-}" == "set-default-agent" ]]; then
  def="${2:?用法: race set-default-agent <agent>}"
  mkdir -p "$(dirname "$DEFAULT_FILE")"
  printf '%s\n' "$def" >"$DEFAULT_FILE"
  echo "✅ 默认 agent 已设为: $def"
  exit 0
fi

# 无任何参数时直接给帮助，不必记 -h
[[ $# -eq 0 ]] && usage

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a | --agents)
      shift
      while [[ $# -gt 0 && "$1" != -* ]]; do AGENTS+=("$1"); shift; done
      ;;
    -i | --issue) ISSUE="${2:?-i 缺少参数}"; shift 2 ;;
    -p | --prompt) PROMPT="${2:?-p 缺少参数}"; shift 2 ;;
    -r | --repo) REPO_ARG="${2:?-r 缺少参数}"; shift 2 ;;
    -b | --base-branch) BASE="${2:?-b 缺少参数}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done

if [[ ${#AGENTS[@]} -eq 0 && -f "$DEFAULT_FILE" ]]; then
  def_agent="$(tr -d '[:space:]' <"$DEFAULT_FILE")"
  [[ -n "$def_agent" ]] && AGENTS=("$def_agent")
fi
if [[ ${#AGENTS[@]} -eq 0 ]]; then
  echo "❌ 必须提供 -a 参赛 Agent 列表（或用 race set-default-agent 设默认值）" >&2
  exit 1
fi

# ---- 仓库路径 ----
if [[ -n "$REPO_ARG" && -d "$REPO_ARG" ]]; then
  REPO="$(cd "$REPO_ARG" && pwd)"
else
  REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "❌ 当前目录不在 git 仓库中" >&2
    exit 1
  }
fi
echo "📦 目标仓库: $REPO"

# ---- 抓取 Issue ----
ISSUE_NUM=""; ISSUE_TITLE=""; ISSUE_BODY=""
if [[ -z "$ISSUE" ]]; then
  echo "🔍 未指定 Issue，取最新一条 open issue ..."
  if ! ISSUE="$(gh issue list --state open --limit 1 --json number --jq '.[0].number // empty')" \
    || [[ -z "$ISSUE" ]]; then
    echo "❌ 取最新 open issue 失败" >&2
    exit 1
  fi
fi
if [[ -n "$ISSUE" ]]; then
  echo "🔍 正在抓取 GitHub Issue: $ISSUE ..."
  if ! out="$(gh issue view "$ISSUE" --json number,title,body)"; then
    echo "❌ 获取 GitHub Issue 失败" >&2
    exit 1
  fi
  ISSUE_NUM="$(jq -r '.number' <<<"$out")"
  ISSUE_TITLE="$(jq -r '.title' <<<"$out")"
  ISSUE_BODY="$(jq -r '.body // ""' <<<"$out")"
  echo "   已获取: #$ISSUE_NUM $ISSUE_TITLE"
fi

# ---- 组装 Prompt ----
FULL_PROMPT=""
if [[ -n "$ISSUE_TITLE" || -n "$ISSUE_BODY" ]]; then
  FULL_PROMPT="# Target Task: GitHub Issue #${ISSUE_NUM} - ${ISSUE_TITLE}"
  if [[ -n "$ISSUE_BODY" ]]; then
    FULL_PROMPT+=$'\n\n## Issue Description:\n'"${ISSUE_BODY}"
  fi
fi
if [[ -n "$PROMPT" ]]; then
  [[ -n "$FULL_PROMPT" ]] && FULL_PROMPT+=$'\n\n'
  FULL_PROMPT+="## User Instructions:"$'\n'"${PROMPT}"
fi
[[ -n "$FULL_PROMPT" ]] && FULL_PROMPT+=$'\n\n'
FULL_PROMPT+=$'## Race Rules:\n- Solve the issue cleanly and completely.\n- Do not touch unrelated files.\n- Verify all changes before reporting.'

echo "🏁 参赛 Agent 规模: ${#AGENTS[@]} 位"
for i in "${!AGENTS[@]}"; do
  parse_spec "${AGENTS[$i]}"
  printf '   [%d] Agent: %s | Model: %s | Effort: %s\n' \
    "$((i + 1))" "$AGENT_ID" "${A_MODEL:-默认}" "${A_EFFORT:-默认}"
done

# ---- 单个 Worker：建 worktree + 起 agent 终端 ----
launch_worker() {
  local idx="$1" raw="$2"
  local agent branch title horse
  parse_spec "$raw"
  agent="$AGENT_ID"
  # 单人参赛不加马，多人赛马才加
  horse="🐎-"
  [[ ${#AGENTS[@]} -eq 1 ]] && horse=""
  branch="${horse}${agent}-${ISSUE_TITLE}"
  # git ref 不允许空格与 /，Issue 标题里常见，统一换成 -
  branch="${branch//[[:space:]\/]/-}"
  title="${horse}${agent}-${ISSUE_TITLE}"

  printf '\n🚀 [Worker %s] 正在初始化: %s\n' "$idx" "$title"
  echo "   分支名: $branch"

  if [[ $DRY_RUN -eq 1 ]]; then
    echo "   [DRY-RUN] 创建 worktree: $branch"
    echo "   [DRY-RUN] 启动 Agent: $agent (model=${A_MODEL:-默认}, effort=${A_EFFORT:-默认})"
    RESULTS+=("ok|${idx}|${raw}|${branch}")
    return 0
  fi

  local wt_cmd=(orca worktree create --name "$branch" --repo "path:$REPO"
    --base-branch "$BASE" --comment "Orca race worker ${idx} for ${raw}" --json)
  if [[ -n "$ISSUE_NUM" ]]; then
    wt_cmd+=(--issue "$ISSUE_NUM")
  fi

  # 原生 agent 且未指定模型：一条命令直接带起
  if is_native "$agent" && [[ -z "$A_MODEL" ]]; then
    wt_cmd+=(--agent "$agent" --prompt "$FULL_PROMPT")
    if "${wt_cmd[@]}" >/dev/null; then
      echo "   ✅ 原生 Agent 工作区创建并启动成功: $agent"
      RESULTS+=("ok|${idx}|${raw}|${branch}")
      return 0
    fi
    echo "   ⚠️ orca worktree create 带 agent 失败，尝试解耦创建" >&2
    wt_cmd=("${wt_cmd[@]:0:${#wt_cmd[@]}-4}")
  fi

  local wt_out
  if ! wt_out="$("${wt_cmd[@]}")"; then
    echo "   ❌ 创建 worktree 失败: $branch" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}")
    return 0
  fi

  # Orca 会给分支加命名空间前缀（如 user/race-x），branch: 选择器匹配不到，
  # 因此一律用 create 返回的 worktree id 定位。
  local wt_sel wt_id
  wt_id="$(jq -r '.result.worktree.id // .result.id // empty' <<<"$wt_out")"
  wt_sel="name:$branch"
  [[ -n "$wt_id" ]] && wt_sel="id:$wt_id"

  # 构造终端启动命令
  local cmd_str="$agent"
  if [[ -n "$A_MODEL" ]]; then
    case "$agent" in
      codex | claude | omp) cmd_str+=" --model $A_MODEL" ;;
    esac
  fi

  local term_out
  if ! term_out="$(orca terminal create --worktree "$wt_sel" --title "$title" --command "$cmd_str" --json)"; then
    echo "   ❌ 创建终端失败: $agent" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}")
    return 0
  fi

  local handle
  handle="$(jq -r '.result.terminal.handle // .result.agentTerminalHandle // .result.startupTerminal.handle // .result.handle // empty' <<<"$term_out")"
  if [[ -n "$handle" ]]; then
    (
      # codebuddy/claude 首次在新目录启动会弹 "Do you trust the files in this folder?",
      # 弹窗会把随后发进去的 prompt 吞掉。tui-idle 会在弹窗绘制前就返回，因此轮询文本。
      local tui_out
      for ((i = 0; i < 60; i++)); do
        sleep 1
        tui_out="$(orca terminal read --terminal "$handle" 2>/dev/null || true)"
        if [[ "$tui_out" == *"Do you trust"* ]]; then
          orca terminal send --terminal "$handle" --text "" --enter
          sleep 5
          break
        fi
      done
      sleep 5
      orca terminal send --terminal "$handle" --text "$FULL_PROMPT" --enter
    ) >/dev/null 2>&1 &
  fi

  echo "   ✅ 终端启动成功: $cmd_str"
  RESULTS+=("ok|${idx}|${raw}|${branch}")
}

RESULTS=()
idx=0
for raw in "${AGENTS[@]}"; do
  idx=$((idx + 1))
  launch_worker "$idx" "$raw"
done

echo
echo "=================================================="
echo "🏆 赛马任务分发完成:"
ok=0
for r in "${RESULTS[@]}"; do
  [[ "${r%%|*}" == "ok" ]] && ok=$((ok + 1))
done
echo "   成功启动: $ok/${#AGENTS[@]}"
for r in "${RESULTS[@]}"; do
  IFS='|' read -r st i a b <<<"$r"
  if [[ "$st" == "ok" ]]; then echo "   ✅ Worker $i: $a -> 分支: $b"; else echo "   ❌ Worker $i: $a -> 分支: $b"; fi
done
echo "=================================================="
