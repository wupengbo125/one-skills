#!/usr/bin/env bash
# hrace — Herdr 多 Agent 并行赛马调度器
# 同一需求 / Issue 同时派给多个 Agent，各开一个 git worktree workspace + pane 并发跑。
#
# 用法:
#   hrace -a codex:gpt-5.4 claude omp [-i <issue>] [-p "补充指令"]
#         [-b main] [--timeout 600000] [--machine "名字"] [--dry-run]
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
用法: hrace -a <agent[:model]...> [-i <issue>] [-p <prompt>] [-b <base>]
            [--timeout <ms>] [--machine <名字>] [--dry-run]

  -a, --agents       参赛 Agent 列表（空格分隔），如: -a codex:gpt-5.4 claude omp
                     kind 取 herdr agent --kind 那 22 个：pi claude codex gemini cursor
                     devin agy cline omp mastracode opencode copilot kimi kiro droid
                     amp grok hermes kilo qodercli qwen maki muse
  -i, --issue        Issue 编号或 URL（gh issue view 抓取）；-1 最新（默认）、-2 倒数第二
  -p, --prompt       追加/独立的自定义提示词
  -b, --base-branch  基线分支（默认 main）
  -sda --set-default-agent <agent>   记住默认 Agent，之后可省略 -a
      --timeout      发完 prompt 后 wait 到 done 的毫秒数（如 600000）；不给则不等
      --machine      打到已保存的 SSH 机器（herdr --machine 前缀）
      --dry-run      只打印命令，不实际创建

说明:
  不给 -i 时自动取最新一条 open issue
  不给 -a 时用默认 Agent（需先 set-default-agent）
EOF
  exit 1
}

sanitize_ref() {
  local s="$1"
  s="$(printf '%s' "$s" | LC_ALL=C tr -d '\001-\037\177')"
  s="${s//[[:space:]]/-}"; s="${s//\~/-}"; s="${s//\^/-}"; s="${s//:/-}"
  s="${s//\?/-}"; s="${s//\*/-}"; s="${s//\[/-}"; s="${s//\]/-}"; s="${s//\\/-}"
  s="${s//../-}"; s="${s//\//-}"
  s="$(printf '%s' "$s" | LC_ALL=C tr -s '-')"
  s="${s#-}"; s="${s%-}"; s="${s#.}"; s="${s%.}"; s="${s%.lock}"
  printf '%s' "$s"
}

# 解析 agent[:model]，写入 AGENT_ID / A_MODEL。必须直接调用，不能 $(...) 包
parse_spec() {
  local spec="$1" rest
  AGENT_ID="${spec%%:*}"
  A_MODEL=""
  rest="${spec#*:}"
  if [[ "$rest" != "$spec" ]]; then A_MODEL="$rest"; fi
}

AGENTS=(); ISSUE=""; PROMPT=""; BASE="main"; TIMEOUT=""; MACHINE=""; DRY_RUN=0
DEFAULT_FILE="$HOME/.config/hrace/default-agent"; DEFAULT_AGENT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -a | --agents) shift; while [[ $# -gt 0 && "$1" != -* ]]; do AGENTS+=("$1"); shift; done ;;
    -i | --issue) ISSUE="${2:?-i 缺少参数}"; shift 2 ;;
    -p | --prompt) PROMPT="${2:?-p 缺少参数}"; shift 2 ;;
    -b | --base-branch) BASE="${2:?-b 缺少参数}"; shift 2 ;;
    -sda | --set-default-agent) DEFAULT_AGENT="${2:?-sda 缺少参数}"; shift 2 ;;
    --timeout) TIMEOUT="${2:?--timeout 缺少参数}"; shift 2 ;;
    --machine) MACHINE="${2:?--machine 缺少参数}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done

# 设默认 agent 后就收工，不跑赛马
if [[ -n "$DEFAULT_AGENT" ]]; then
  mkdir -p "$(dirname "$DEFAULT_FILE")"
  printf '%s\n' "$DEFAULT_AGENT" >"$DEFAULT_FILE"
  echo "✅ 默认 agent 已设为: $DEFAULT_AGENT"
  exit 0
fi

if [[ ${#AGENTS[@]} -eq 0 && -f "$DEFAULT_FILE" ]]; then
  def_agent="$(tr -d '[:space:]' <"$DEFAULT_FILE")"
  if [[ -n "$def_agent" ]]; then AGENTS=("$def_agent"); fi
fi
if [[ ${#AGENTS[@]} -eq 0 ]]; then
  echo "❌ 必须提供 -a 参赛 Agent 列表（或用 -sda 设默认值）" >&2
  exit 1
fi

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "❌ 当前目录不在 git 仓库中" >&2; exit 1; }
echo "📦 目标仓库: $REPO"

ISSUE_NUM=""; ISSUE_TITLE=""; ISSUE_BODY=""; ISSUE_URL=""

if [[ "$ISSUE" =~ ^-[0-9]+$ ]]; then
  n="${ISSUE#-}"
  echo "🔍 取倒数第 ${n} 条 open issue ..."
  ISSUE="$(gh issue list --state open --limit "$n" --json number --jq ".[$((n - 1))].number // empty")" \
    || { echo "❌ 取倒数第 ${n} 条 open issue 失败" >&2; exit 1; }
fi
if [[ -z "$ISSUE" ]]; then
  echo "🔍 未指定 Issue，取最新一条 open issue ..."
  ISSUE="$(gh issue list --state open --limit 1 --json number --jq '.[0].number // empty')" \
    || { echo "❌ 取最新 open issue 失败" >&2; exit 1; }
fi
if [[ -n "$ISSUE" ]]; then
  out="$(gh issue view "$ISSUE" --json number,title,body,url)"
  ISSUE_NUM="$(jq -r '.number' <<<"$out")"
  ISSUE_TITLE="$(jq -r '.title' <<<"$out")"
  ISSUE_BODY="$(jq -r '.body // ""' <<<"$out")"
  ISSUE_URL="$(jq -r '.url // ""' <<<"$out")"
  echo "   已获取: #$ISSUE_NUM $ISSUE_TITLE"
fi

FULL_PROMPT=""
if [[ -n "$ISSUE_TITLE" || -n "$ISSUE_BODY" ]]; then
  FULL_PROMPT="# Target Task: GitHub Issue #${ISSUE_NUM} - ${ISSUE_TITLE}"
  [[ -n "$ISSUE_BODY" ]] && FULL_PROMPT+=$'\n\n## Issue Description:\n'"${ISSUE_BODY}"
fi
if [[ -n "$PROMPT" ]]; then
  [[ -n "$FULL_PROMPT" ]] && FULL_PROMPT+=$'\n\n'
  FULL_PROMPT+="## User Instructions:"$'\n'"${PROMPT}"
fi
if [[ -n "$FULL_PROMPT" ]]; then FULL_PROMPT+=$'\n\n'; fi
FULL_PROMPT+=$'## Race Rules:\n- Solve the issue cleanly and completely.\n- Do not touch unrelated files.\n- Verify all changes before reporting.'

# 赛次标识（打在 --label 上，一屏回收用）
RACE_ID="$(printf '%03d' $((RANDOM % 1000)))"
# 每位参赛马自己的随机 3 位标识，同轮内去重（-a omp omp 也不撞）
RACE_IDS=()
for _ in "${AGENTS[@]}"; do
  while :; do
    rid="$(printf '%03d' $((RANDOM % 1000)))"
    [[ " ${RACE_IDS[*]-} " == *" $rid "* ]] && continue
    RACE_IDS+=("$rid")
    break
  done
done
unset rid

launch_horse() {
  local idx="$1" raw="$2" agent model branch slug horse model_slug name out pane
  parse_spec "$raw"; agent="$AGENT_ID"; model="$A_MODEL"

  horse="🐎-"
  if [[ ${#AGENTS[@]} -eq 1 ]]; then horse=""; fi
  model_slug=""
  if [[ -n "$model" ]]; then model_slug="-$(sanitize_ref "$model")"; fi
  slug="$(sanitize_ref "$ISSUE_TITLE")"
  [[ -n "$slug" ]] || slug="issue-${ISSUE_NUM:-task}"

  # 分支名：<马><该马的随机3位>-<agent>[-<model>]-<标题>
  branch="${horse}${RACE_IDS[$((idx - 1))]}-${agent}${model_slug}-${slug}"
  # agent 名只认 [a-z][a-z0-9_-]{0,31}，🐎 和中文进不去，单起一个短名；
  # 带该马的随机 3 位，避免和上一轮留下的同名 agent 撞（herdr agent 名必须唯一）
  name="h$(printf '%s' "$agent" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')-${RACE_IDS[$((idx - 1))]}"

  printf '\n🚀 [Horse %s] %s\n' "$idx" "$branch"
  echo "   分支: $branch   赛马名: $name"

  # --machine 是 herdr 的全局前缀，必须排在子命令前
  local h=(herdr)
  if [[ -n "$MACHINE" ]]; then h+=(--machine "$MACHINE"); fi

  local wt=("${h[@]}" worktree create --cwd "$REPO" --branch "$branch" --base "$BASE"
    --label "$branch" --no-focus)
  local as=("${h[@]}" agent start "$name" --kind "$agent")
  if [[ -n "$model" ]]; then as+=(-- --model "$model"); fi
  # ponytail: pane id 由 herdr 返回，命令里先留占位，拿到后填
  local ap=("${h[@]}" agent prompt "$name" "$FULL_PROMPT")
  # prompt 和 wait 拆开：herdr prompt --wait 要求提交后 5 秒内观察到 working，
  # 慢启动的 agent 会被误判 agent_prompt_stalled（prompt 其实已送达）。
  # wait 不带 --until：默认接受 idle/done/blocked（agent 跑完回 idle 也算完成）
  local aw=("${h[@]}" agent wait "$name" --timeout "${TIMEOUT:-600000}")

  if [[ $DRY_RUN -eq 1 ]]; then
    printf '   [DRY-RUN]'; printf ' %q' "${wt[@]}"; printf '\n'
    printf '   [DRY-RUN]'; printf ' %q' "${as[@]:0:${#h[@]}}"; printf ' agent start %s --kind %s --pane <pane_id>%s\n' "$name" "$agent" "${model:+ -- --model $model}"
    printf '   [DRY-RUN]'; printf ' %q' "${ap[@]:0:${#h[@]}}"; printf ' agent prompt %s "<prompt>"\n' "$name"
    printf '   [DRY-RUN]'; printf ' %q' "${aw[@]:0:${#h[@]}}"; printf ' agent wait %s --until done --timeout %s\n' "$name" "${TIMEOUT:-600000}"
    RESULTS+=("ok|${idx}|${raw}|${branch}|${name}")
    return 0
  fi

  if ! out="$("${wt[@]}" 2>&1)"; then
    echo "   ❌ 创建 worktree 失败" >&2
    echo "$out" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}|-")
    return 0
  fi
  pane="$(jq -r '.result.root_pane.pane_id // .result.pane.pane_id // .result.pane_id // empty' <<<"$out" 2>/dev/null || true)"
  if [[ -z "$pane" ]]; then
    echo "   ❌ 拿不到 pane id: $out" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}|-")
    return 0
  fi

  if ! out="$("${as[@]}" --pane "$pane" 2>&1)"; then
    echo "   ❌ agent start 失败: $agent" >&2
    echo "$out" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}|-")
    return 0
  fi

  if ! out="$("${ap[@]}" 2>&1)"; then
    echo "   ❌ prompt 未送达: $(head -c 120 <<<"$out")" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}|${name}")
    return 0
  fi

  # 等马跑完：超时只说明没在时限内跑到 done，prompt 已经送达，agent 可能还在跑
  if ! out="$("${aw[@]}" 2>&1)"; then
    echo "   ⏳ 已发车但未等到完成（可能还在跑）: $(head -c 120 <<<"$out")" >&2
    RESULTS+=("warn|${idx}|${raw}|${branch}|${name}")
    return 0
  fi
  echo "   ✅ 跑完了: $name"
  RESULTS+=("ok|${idx}|${raw}|${branch}|${name}")
}

RESULTS=()
idx=0
for raw in "${AGENTS[@]}"; do idx=$((idx + 1)); launch_horse "$idx" "$raw"; done

echo
echo "=================================================="
echo "🏆 赛马 #${RACE_ID} 分发完成  ${TIMEOUT:+（已等待 ${TIMEOUT}）}"
for r in "${RESULTS[@]}"; do
  IFS='|' read -r st i a b id <<<"$r"
  case "$st" in
    ok)   echo "   ✅ Horse $i: $a -> $b (agent ${id})" ;;
    warn) echo "   ⏳ Horse $i: $a -> $b (agent ${id}，未等到 done，自己去 read)" ;;
    *)    echo "   ❌ Horse $i: $a -> $b" ;;
  esac
done
echo "   收卷: herdr agent read <赛马名> --source recent-unwrapped --lines 120"
echo "   看盘: herdr agent list"
echo "=================================================="
