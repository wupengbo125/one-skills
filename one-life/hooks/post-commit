#!/bin/bash
# post-commit: one-life 提交自动同步索引
# 仅在 one-life 仓库提交时，把改动的 .md 文件增量同步进检索索引。
# 注：首次提交没有 HEAD^，回退为 git show HEAD 取文件列表，否则索引漏同步。

repo=$(git rev-parse --show-toplevel 2>/dev/null)
if [ "$repo" = "$HOME/onespace/github/one-life" ]; then
  if git rev-parse --verify HEAD^ >/dev/null 2>&1; then
    changed=$(git diff --name-only HEAD^ HEAD 2>/dev/null)
  else
    changed=$(git show --pretty=format: --name-only HEAD 2>/dev/null)
  fi
  echo "$changed" | grep '\.md$' | while read -r f; do
    python3 "$(dirname "$0")/fts.py" sync "$f" >/dev/null 2>&1
  done
fi
exit 0
