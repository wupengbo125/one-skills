#!/usr/bin/env bash
# prace — Paseo 多 Agent 并行赛马调度器
# 同一需求 / Issue 同时派给多个 Agent，各自独立 worktree workspace 并发跑。
#
# 用法:
#   prace -a codex:gpt-5.4 claude:opus-4.6 omp [-i <issue>] [-p "补充指令"]
#         [-b main] [--timeout 30m] [--host host:port] [--dry-run]
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
用法: prace -a <agent[:model]...> [-i <issue>] [-p <prompt>] [-b <base>]
            [--timeout <duration>] [--host <host:port>] [--dry-run]

  -a, --agents       参赛 Agent 列表（空格分隔），如: -a codex:gpt-5.4 claude omp
  -i, --issue        Issue 编号或 URL（gh issue view 抓取）；-1 最新（默认）、-2 倒数第二
  -p, --prompt       追加/独立的自定义提示词
  -b, --base-branch  基线分支（默认 main）
  -sda --set-default-agent <agent>   记住默认 Agent，之后可省略 -a
      --timeout      发完后 wait 每个 agent（30s / 10m / 1h）；不给则发完即返回
      --host         远程 daemon（host:port）
      --dry-run      只打印命令，不实际创建

说明:
  不给 -i 时自动取最新一条 open issue
  不给 -a 时用默认 Agent（需先 set-default-agent）
EOF
  exit 1
}

sanitize_ref() {
  local s="$1"
  s="$(printf '%s' "$s" | LC_ALL=C tr -d '\001-\037\177')"
  s="${s//[[:space:]]/-}"; s="${s//\~/-}"; s="${s//\^/-}"; s="${s//:/-}"
  s="${s//\?/-}"; s="${s//\*/-}"; s="${s//\[/-}"; s="${s//\]/-}"; s="${s//\\/-}"
  s="${s//../-}"; s="${s//\//-}"
  s="$(printf '%s' "$s" | LC_ALL=C tr -s '-')"
  s="${s#-}"; s="${s%-}"; s="${s#.}"; s="${s%.}"; s="${s%.lock}"
  printf '%s' "$s"
}

# 常见叫法 → Paseo provider id（Paseo 里 codebuddy 的 id 是 codebuddy-code）
normalize_agent() {
  case "$1" in
    codebuddy | cbc | codebuddy-code) echo "codebuddy-code" ;;
    *) echo "$1" ;;
  esac
}

# 解析 agent[:model]，写入 AGENT_ID / A_MODEL。必须直接调用，不能 $(...) 包
parse_spec() {
  local spec="$1" rest
  AGENT_ID="$(normalize_agent "${spec%%:*}")"
  A_MODEL=""
  rest="${spec#*:}"
  if [[ "$rest" != "$spec" ]]; then A_MODEL="$rest"; fi
}

AGENTS=(); ISSUE=""; PROMPT=""; BASE="main"; TIMEOUT=""; HOST=""; DRY_RUN=0
DEFAULT_FILE="$HOME/.config/prace/default-agent"; DEFAULT_AGENT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -a | --agents) shift; while [[ $# -gt 0 && "$1" != -* ]]; do AGENTS+=("$1"); shift; done ;;
    -i | --issue) ISSUE="${2:?-i 缺少参数}"; shift 2 ;;
    -p | --prompt) PROMPT="${2:?-p 缺少参数}"; shift 2 ;;
    -b | --base-branch) BASE="${2:?-b 缺少参数}"; shift 2 ;;
    -sda | --set-default-agent) DEFAULT_AGENT="${2:?-sda 缺少参数}"; shift 2 ;;
    --timeout) TIMEOUT="${2:?--timeout 缺少参数}"; shift 2 ;;
    --host) HOST="${2:?--host 缺少参数}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done

# 设默认 agent 后就收工，不跑赛马
if [[ -n "$DEFAULT_AGENT" ]]; then
  mkdir -p "$(dirname "$DEFAULT_FILE")"
  printf '%s\n' "$DEFAULT_AGENT" >"$DEFAULT_FILE"
  echo "✅ 默认 agent 已设为: $DEFAULT_AGENT"
  exit 0
fi

if [[ ${#AGENTS[@]} -eq 0 && -f "$DEFAULT_FILE" ]]; then
  def_agent="$(tr -d '[:space:]' <"$DEFAULT_FILE")"
  if [[ -n "$def_agent" ]]; then AGENTS=("$def_agent"); fi
fi
if [[ ${#AGENTS[@]} -eq 0 ]]; then
  echo "❌ 必须提供 -a 参赛 Agent 列表（或用 -sda 设默认值）" >&2
  exit 1
fi

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "❌ 当前目录不在 git 仓库中" >&2; exit 1; }
echo "📦 目标仓库: $REPO"

# 开跑前查 provider 名字：paseo run 是先建 workspace 再创建 agent，
# 名字写错会留下一个空 worktree + 分支（踩过）。只拦"不存在"的名字——
# provider 状态在刷新/预热期可能短暂非 available，那种交给 paseo 自己报错。
if KNOWN="$(paseo provider ls 2>/dev/null | awk 'NR>1{print $1}' | tr '\n' ' ')" && [[ -n "$KNOWN" ]]; then
  for raw in "${AGENTS[@]}"; do
    parse_spec "$raw"
    if [[ " $KNOWN " != *" $AGENT_ID "* ]]; then
      echo "❌ 没有这个 provider: $AGENT_ID（$raw）" >&2
      echo "   已配置: $KNOWN" >&2
      exit 1
    fi
  done
fi

ISSUE_NUM=""; ISSUE_TITLE=""; ISSUE_BODY=""; ISSUE_URL=""

if [[ "$ISSUE" =~ ^-[0-9]+$ ]]; then
  n="${ISSUE#-}"
  echo "🔍 取倒数第 ${n} 条 open issue ..."
  ISSUE="$(gh issue list --state open --limit "$n" --json number --jq ".[$((n - 1))].number // empty")" \
    || { echo "❌ 取倒数第 ${n} 条 open issue 失败" >&2; exit 1; }
fi
if [[ -z "$ISSUE" ]]; then
  echo "🔍 未指定 Issue，取最新一条 open issue ..."
  ISSUE="$(gh issue list --state open --limit 1 --json number --jq '.[0].number // empty')" \
    || { echo "❌ 取最新 open issue 失败" >&2; exit 1; }
fi
if [[ -n "$ISSUE" ]]; then
  out="$(gh issue view "$ISSUE" --json number,title,body,url)"
  ISSUE_NUM="$(jq -r '.number' <<<"$out")"
  ISSUE_TITLE="$(jq -r '.title' <<<"$out")"
  ISSUE_BODY="$(jq -r '.body // ""' <<<"$out")"
  ISSUE_URL="$(jq -r '.url // ""' <<<"$out")"
  echo "   已获取: #$ISSUE_NUM $ISSUE_TITLE"
fi

FULL_PROMPT=""
if [[ -n "$ISSUE_TITLE" || -n "$ISSUE_BODY" ]]; then
  FULL_PROMPT="# Target Task: GitHub Issue #${ISSUE_NUM} - ${ISSUE_TITLE}"
  [[ -n "$ISSUE_BODY" ]] && FULL_PROMPT+=$'\n\n## Issue Description:\n'"${ISSUE_BODY}"
fi
if [[ -n "$PROMPT" ]]; then
  [[ -n "$FULL_PROMPT" ]] && FULL_PROMPT+=$'\n\n'
  FULL_PROMPT+="## User Instructions:"$'\n'"${PROMPT}"
fi
if [[ -n "$FULL_PROMPT" ]]; then FULL_PROMPT+=$'\n\n'; fi
FULL_PROMPT+=$'## Race Rules:\n- Solve the issue cleanly and completely.\n- Do not touch unrelated files.\n- Verify all changes before reporting.'

# 赛次标识（打在 --label 上，一屏回收用）
RACE_ID="$(printf '%03d' $((RANDOM % 1000)))"
# 每位参赛马自己的随机 3 位标识，同轮内去重（-a omp omp 也不撞）
RACE_IDS=()
for _ in "${AGENTS[@]}"; do
  while :; do
    rid="$(printf '%03d' $((RANDOM % 1000)))"
    [[ " ${RACE_IDS[*]-} " == *" $rid "* ]] && continue
    RACE_IDS+=("$rid")
    break
  done
done
unset rid

launch_horse() {
  local idx="$1" raw="$2" agent model branch slug title horse model_slug out id
  parse_spec "$raw"; agent="$AGENT_ID"; model="$A_MODEL"

  horse="🐎-"
  if [[ ${#AGENTS[@]} -eq 1 ]]; then horse=""; fi
  model_slug=""
  if [[ -n "$model" ]]; then model_slug="-$(sanitize_ref "$model")"; fi
  slug="$(sanitize_ref "$ISSUE_TITLE")"
  [[ -n "$slug" ]] || slug="issue-${ISSUE_NUM:-task}"

  # 分支名：<马><该马的随机3位>-<agent>[-<model>]-<标题>
  branch="${horse}${RACE_IDS[$((idx - 1))]}-${agent}${model_slug}-${slug}"
  title="${horse}${agent}${model_slug}-${ISSUE_TITLE}"

  printf '\n🚀 [Horse %s] %s\n' "$idx" "$title"
  echo "   分支: $branch"

  local cmd=(paseo run "$FULL_PROMPT"
    --provider "$agent"
    --new-workspace worktree --worktree-mode branch-off
    --new-branch "$branch" --base "$BASE" --worktree-slug "$branch"
    --title "$title"
    --label "race=${RACE_ID}" --label "horse=${idx}"
    --background --cwd "$REPO" --json --quiet)
  if [[ -n "$model" ]]; then cmd+=(--model "$model"); fi
  if [[ -n "$HOST" ]]; then cmd+=(--host "$HOST"); fi

  if [[ $DRY_RUN -eq 1 ]]; then
    printf '   [DRY-RUN]'; printf ' %q' "${cmd[@]:0:4}"; printf ' ...\n'
    RESULTS+=("ok|${idx}|${raw}|${branch}|-")
    return 0
  fi

  if ! out="$("${cmd[@]}" 2>&1)"; then
    echo "   ❌ 启动失败: $agent" >&2
    echo "$out" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}|-")
    return 0
  fi
  # paseo run 即使 --json 也会在 JSON 前插 "Created workspace ..." / "Tip: ..." 提示行，
  # 所以不解析 JSON，直接抓最后一个 UUID（--quiet 下 stdout 就只有这个 UUID）。
  id="$(printf '%s' "$out" | grep -Eo '[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}' | tail -1 || true)"
  if [[ -z "$id" ]]; then
    echo "   ❌ 拿不到 agent id" >&2
    echo "$out" >&2
    RESULTS+=("fail|${idx}|${raw}|${branch}|-")
    return 0
  fi
  echo "   ✅ agent: ${id:-未知}"
  if [[ -n "$TIMEOUT" && "$id" != "未知" ]]; then paseo wait "$id" --timeout "$TIMEOUT" >/dev/null 2>&1; fi
  RESULTS+=("ok|${idx}|${raw}|${branch}|${id:-未知}")
}

RESULTS=()
idx=0
for raw in "${AGENTS[@]}"; do idx=$((idx + 1)); launch_horse "$idx" "$raw"; done

echo
echo "=================================================="
echo "🏆 赛马 #${RACE_ID} 分发完成  ${TIMEOUT:+（已等待 ${TIMEOUT}）}"
for r in "${RESULTS[@]}"; do
  IFS='|' read -r st i a b id <<<"$r"
  [[ "$st" == "ok" ]] && echo "   ✅ Horse $i: $a -> $b (agent ${id})" \
                     || echo "   ❌ Horse $i: $a -> $b"
done
echo "   记分牌: paseo ls --label race=${RACE_ID} -g"
echo "=================================================="
